      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleeve kommt ohne jede Gewährleistung. Weitergabe und Veränderung sind unter den Bedingungen der GNU GPL v3 oder einer späteren Version erlaubt."
          }
        },
        "es" : {
          "stringUnit" : {
